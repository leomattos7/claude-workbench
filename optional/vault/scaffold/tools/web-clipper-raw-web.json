{
  "schemaVersion": "0.1.0",
  "name": "raw-web",
  "behavior": "create",
  "noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}} {{title|safe_name}}",
  "path": "raw/web",
  "noteContentFormat": "# {{title}}\n\n{{content}}",
  "properties": [
    {"name": "source", "value": "{{url}}", "type": "text"},
    {"name": "author", "value": "{{author}}", "type": "text"},
    {"name": "published", "value": "{{published}}", "type": "date"},
    {"name": "clipped", "value": "{{date|date:\"YYYY-MM-DD\"}}", "type": "date"},
    {"name": "description", "value": "{{description}}", "type": "text"}
  ],
  "triggers": []
}
