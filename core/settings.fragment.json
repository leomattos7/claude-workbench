{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "{{MODS_DIR}}/model-router:{{MODS_DIR}}/session-board",
    "OMC_CONTEXT_GUARD_THRESHOLD": "70"
  },
  "permissions": {
    "deny": [
      "Agent(fork)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/workbench/session-start-handoffs.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "oh-my-claudecode@omc": true,
    "mattpocock-skills@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git",
        "ref": "v5.7.31"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  }
}
